# OPAL dotenv example.
# Startup reads ./.env by default; real environment variables always win,
# including empty strings. Use --env-file PATH for another file, or
# --no-env-file to disable loading and initialization. Secret values stay
# local; this example is safe to commit.

# OPAL_SAY_CONFIG
#OPAL_SAY_CONFIG=config/service.yaml

# OPAL_SAY_HOST
#OPAL_SAY_HOST=127.0.0.1

# OPAL_SAY_PORT
#OPAL_SAY_PORT=8001

# OPAL_SAY_DATA_DIR
#OPAL_SAY_DATA_DIR=var

# OPAL_SAY_CONFIG_DIR
#OPAL_SAY_CONFIG_DIR=config

# OPAL_SAY_SPA_DIR
#OPAL_SAY_SPA_DIR=

# OPAL_SAY_LOG_DIR
#OPAL_SAY_LOG_DIR=logs

# OPAL_SAY_PERSONA_OWNER_URL
#OPAL_SAY_PERSONA_OWNER_URL=

# OPAL_SAY_API_URL
#OPAL_SAY_API_URL=http://127.0.0.1:8001

